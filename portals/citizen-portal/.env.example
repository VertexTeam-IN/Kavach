# Copy to portals/citizen-portal/.env
# Citizen Services Portal = OIDC client #2 of Kavach (values match backend/seed_clients.json)
KAVACH_ISSUER=http://localhost:3000
KAVACH_CLIENT_ID=citizen-portal
KAVACH_CLIENT_SECRET=citizen-portal-dev-secret
APP_URL=http://127.0.0.1:5000
REDIRECT_URI=http://127.0.0.1:5000/callback
# Signs this portal's own session cookie. Change it for anything beyond a demo.
SESSION_SECRET=citizen-portal-session-secret-change-me
# Allows OAuth over plain http on localhost. Never set this in production.
AUTHLIB_INSECURE_TRANSPORT=1
