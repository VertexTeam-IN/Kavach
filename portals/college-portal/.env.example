# Copy to portals/college-portal/.env.local
# College Portal = OIDC client #1 of Kavach (values match backend/seed_clients.json)
KAVACH_ISSUER=http://localhost:3000
KAVACH_CLIENT_ID=college-portal
KAVACH_CLIENT_SECRET=college-portal-dev-secret
APP_URL=http://127.0.0.1:3001
REDIRECT_URI=http://127.0.0.1:3001/api/auth/callback
# Signs this portal's own session cookie. Change it for anything beyond a demo (min. 32 chars).
SESSION_SECRET=college-portal-session-secret-change-me-32chars
