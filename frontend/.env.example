# Copy to frontend/.env.local

# Backend API the Next.js proxy forwards to. Default shown.
# KAVACH_API=http://127.0.0.1:8000
# Set to 1 only behind your own reverse proxy (nginx/Caddy) that OVERWRITES X-Forwarded-For.
# Otherwise client IP headers are stripped so rate limits can't be bypassed. See docs/firewall.md.
# KAVACH_BEHIND_PROXY=1

# DEMO ONLY — turns on the Attack Lab page at http://localhost:3000/lab.
# Leave unset anywhere real; /lab and /lab-api then return 404.
KAVACH_ENABLE_LAB=1
# Where the lab server runs (attack-lab/lab.py). Default shown.
# KAVACH_LAB_API=http://127.0.0.1:4000
