# Copy this file to .env and adjust if needed.

# PostgreSQL connection (user/password/database created in the setup step)
DATABASE_URL=postgresql+psycopg://kavach:kavach@127.0.0.1:5432/kavach

# WebAuthn relying party. Always open Kavach at http://localhost:3000 (not 127.0.0.1)
RP_ID=localhost
RP_NAME=Kavach
ORIGIN=http://localhost:3000

# OIDC issuer = the public origin of Kavach (the Next.js app that proxies to this API)
ISSUER=http://localhost:3000

# Session cookie
COOKIE_NAME=kavach_sid
COOKIE_SECURE=false

# Demo mode enables the simulated SMS inbox (/mock-phone)
DEMO_MODE=true

# IPs of your own reverse proxies (comma-separated). X-Forwarded-For is only trusted from these.
# Leave empty for the local setup. Behind nginx/Caddy on the same machine: TRUSTED_PROXIES=127.0.0.1
TRUSTED_PROXIES=
